  {id:2,title:"ليفربول يستعد لمواجهة نارية أمام مان سيتي",source:"Goal Zone",time:"منذ 4 ساعات",cat:"الدوري الإنجليزي",icon:"🔥"},
  {id:3,title:"الأهلي يستعد للقمة الأفريقية أمام الزمالك",source:"Goal Zone",time:"منذ 6 ساعات",cat:"الدوري المصري",icon:"🇪🇬"},
  {id:4,title:"بيراميدز يعلن التعاقد مع مهاجم جديد",source:"Goal Zone",time:"منذ 8 ساعات",cat:"انتقالات",icon:"✍️"},
  {id:5,title:"دوري أبطال أوروبا.. نظام جديد بمشاركة 36 فريقاً",source:"Goal Zone",time:"منذ يوم",cat:"أبطال أوروبا",icon:"🏆"},
  {id:6,title:"غوارديولا: نستحق الفوز وننتظر رد الفعل",source:"Goal Zone",time:"منذ يوم",cat:"الدوري الإنجليزي",icon:"🎙️"}
];

/* ============= Helpers ============= */
function t(id){return TEAMS[id]||{name:"فريق",short:"?"}}
function l(id){return LEAGUES.find(x=>x.id===id)||{name:"بطولة"}}
function statusLabel(m){
  if(m.status==="live") return {text:`مباشر ${m.min}'`,cls:"live"};
  if(m.status==="finished") return {text:"انتهت",cls:"finished"};
  return {text:"لم تبدأ",cls:"upcoming"};
}

/* ============= Render Match Card ============= */
function renderMatch(m, full){
  const h=t(m.home), a=t(m.away), s=statusLabel(m);
  const center = m.status==="upcoming"
    ? `<div class="mc-time">${m.time}</div>`
    : `<div class="mc-score">${m.hs} - ${m.as}</div>`;
  return `
  <div class="match-card ${full?'full':''}" onclick="openDetail(${m.id})">
    <div class="mc-head">
      <div class="mc-league">${l(m.league).name}</div>
      <div class="mc-status ${s.cls}">${s.text}</div>
    </div>
    <div class="mc-body">
      <div class="mc-team">
        <div class="mc-logo">${h.short}</div>
        <div class="mc-name">${h.name}</div>
      </div>
      ${center}
      <div class="mc-team">
        <div class="mc-logo">${a.short}</div>
        <div class="mc-name">${a.name}</div>
      </div>
    </div>
    ${m.stadium?`<div class="mc-stadium">🏟️ ${m.stadium}</div>`:""}
  </div>`;
}

/* ============= Render Pages ============= */
function renderHome(){
  const live = MATCHES.filter(m=>m.status==="live");
  const today = MATCHES.filter(m=>m.date==="اليوم");
  document.getElementById("homeLive").innerHTML = live.length
    ? live.map(m=>renderMatch(m,false)).join("")
    : `<div class="empty">لا توجد مباريات مباشرة</div>`;

  document.getElementById("homeToday").innerHTML = today.length
    ? today.map(m=>`<div style="padding:0 16px 10px">${renderMatch(m,true)}</div>`).join("")
    : `<div class="empty">لا توجد مباريات اليوم</div>`;

  document.getElementById("homeLeagues").innerHTML = LEAGUES.map(x=>
    `<div class="chip" onclick="goPage('leagues')">${x.flag} ${x.name}</div>`).join("");

  document.getElementById("homeNews").innerHTML = NEWS.slice(0,3).map(n=>`
    <div class="news-item">
      <div class="news-thumb">${n.icon}</div>
      <div class="news-body">
        <div class="news-title">${n.title}</div>
        <div class="news-meta">${n.cat} • ${n.time}</div>
      </div>
    </div>`).join("");
}

let matchTab = "today";
function setMatchTab(tab){
  matchTab = tab;
  document.querySelectorAll("#matchTabs .chip").forEach(c=>{
    c.classList.toggle("on", c.dataset.tab===tab);
  });
  renderMatches();
}
function renderMatches(){
  let list = [];
  if(matchTab==="live") list = MATCHES.filter(m=>m.status==="live");
  else if(matchTab==="today") list = MATCHES.filter(m=>m.date==="اليوم");
  else list = MATCHES.filter(m=>m.status==="upcoming");
  document.getElementById("matchesList").innerHTML = list.length
    ? list.map(m=>`<div style="padding:0 16px 10px">${renderMatch(m,true)}</div>`).join("")
    : `<div class="empty">لا توجد مباريات</div>`;
}

function renderLeagues(){
  document.getElementById("leaguesList").innerHTML = LEAGUES.map(lg=>{
    const count = MATCHES.filter(m=>m.league===lg.id).length;
    return `
    <div class="news-item" onclick="filterLeague(${lg.id})">
      <div class="news-thumb" style="font-size:22px">${lg.flag}</div>
      <div class="news-body">
        <div class="news-title">${lg.name}</div>
        <div class="news-meta">${count} مباريات</div>
      </div>
    </div>`;
  }).join("");
}

function filterLeague(id){
  const list = MATCHES.filter(m=>m.league===id);
  const lg = l(id);
  goPage('matches');
  document.getElementById("matchesList").innerHTML = `
    <div style="padding:8px 16px;color:var(--green);font-weight:700">${lg.name}</div>
    ${list.length?list.map(m=>`<div style="padding:0 16px 10px">${renderMatch(m,true)}</div>`).join(""):'<div class="empty">لا توجد مباريات</div>'}
  `;
}

function renderNews(){
  document.getElementById("newsList").innerHTML = NEWS.map(n=>`
    <div class="news-item">
      <div class="news-thumb">${n.icon}</div>
      <div class="news-body">
        <div class="news-title">${n.title}</div>
        <div class="news-meta">${n.cat} • ${n.source} • ${n.time}</div>
      </div>
    </div>`).join("");
}

/* ============= Detail Page ============= */
function openDetail(id){
  const m = MATCHES.find(x=>x.id===id);
  if(!m) return;
  const h=t(m.home), a=t(m.away), s=statusLabel(m);
  const center = m.status==="upcoming"
    ? `<div class="sb-vs">VS</div>`
    : `<div class="sb-score">${m.hs} - ${m.as}</div>`;

  const eventsHTML = (m.events&&m.events.length)
    ? m.events.map(e=>{
        const icon = {goal:"⚽",yellow:"🟨",red:"🟥",sub:"🔁"}[e.type]||"•";
        const who = t(e.team).name;
        const extra = e.assist?`<div style="font-size:10px;color:var(--text-3)">صناعة: ${e.assist}</div>`:"";
        return `<div class="event-row">
          <div class="event-min">${e.min}'</div>
          <div class="event-icon">${icon}</div>
          <div class="event-text"><b>${e.player}</b> — ${who}${extra}</div>
        </div>`;
      }).join("")
    : `<div class="empty">لا توجد أحداث بعد</div>`;

  document.getElementById("detailContent").innerHTML = `
    <div class="score-board">
      <div class="sb-league">${l(m.league).name}</div>
      <div class="sb-status"><span class="mc-status ${s.cls}">${s.text}</span></div>
      <div class="sb-teams">
        <div class="sb-team">
          <div class="sb-logo">${h.short}</div>
          <div class="sb-name">${h.name}</div>
        </div>
        ${center}
        <div class="sb-team">
          <div class="sb-logo">${a.short}</div>
          <div class="sb-name">${a.name}</div>
        </div>
      </div>
      ${m.stadium?`<div class="sb-stadium">🏟️ ${m.stadium} • ${m.date} ${m.time}</div>`:""}
    </div>

    <div class="events-box">
      <div class="events-title">📋 أحداث المباراة</div>
      ${eventsHTML}
    </div>
  `;

  document.querySelectorAll(".page").forEach(p=>p.classList.remove("on"));
  document.getElementById("page-detail").classList.add("on");
  window.scrollTo({top:0,behavior:"smooth"});
  history.pushState({page:"detail"}, "");
}

function closeDetail(){
  goPage(currentPage||"home");
}

/* ============= Navigation ============= */
let currentPage = "home";
function goPage(name){
  currentPage = name;
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("on"));
  const pg = document.getElementById("page-"+name);
  if(pg) pg.classList.add("on");
  document.querySelectorAll(".nav-item").forEach(n=>{
    n.classList.toggle("on", n.dataset.page===name);
  });
  window.scrollTo({top:0,behavior:"smooth"});
}

/* ============= Toast ============= */
let toastTimer;
function toast(msg){
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.classList.add("on");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>el.classList.remove("on"), 2000);
}

/* ============= Back button ============= */
window.addEventListener("popstate", ()=>{
  if(document.getElementById("page-detail").classList.contains("on")){
    goPage(currentPage||"home");
  }
});

/* ============= Boot ============= */
window.addEventListener("DOMContentLoaded", ()=>{
  // Splash
  setTimeout(()=>document.getElementById("splash").classList.add("hide"), 1600);

  // Render
  renderHome();
  renderMatches();
  renderLeagues();
  renderNews();

  // PWA-like behavior: block context menu on long press icons
  document.addEventListener("contextmenu", e=>{
    if(e.target.closest(".nav-item")) e.preventDefault();
  });
});
</script>

