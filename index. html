<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#000000">
<title>Goal Zone - عالم كرة القدم</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚽</text></svg>">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --black:#000;--bg:#0a0e14;--surface:#141a22;--surface-2:#1e2630;
  --green:#00e676;--green-2:#00b85a;--blue:#2196f3;--red:#ff3b30;
  --text:#fff;--text-2:#b0b8c1;--text-3:#6b7280;
}
html,body{height:100%;overflow-x:hidden}
body{
  font-family:'Segoe UI',Tahoma,Arial,sans-serif;
  background:var(--black);color:var(--text);
  direction:rtl;line-height:1.5;
  -webkit-font-smoothing:antialiased;
  padding-bottom:80px;
}

/* ===== Splash ===== */
#splash{
  position:fixed;inset:0;z-index:9999;
  background:radial-gradient(circle at center,#0a0e14 0%,#000 100%);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  transition:opacity .5s ease,visibility .5s ease;
}
#splash.hide{opacity:0;visibility:hidden}
.splash-icon{
  width:110px;height:110px;border-radius:28px;
  background:linear-gradient(135deg,var(--green),var(--green-2));
  display:flex;align-items:center;justify-content:center;
  font-size:60px;box-shadow:0 20px 60px rgba(0,230,118,.4);
  animation:pop .8s cubic-bezier(.34,1.56,.64,1);
}
@keyframes pop{0%{transform:scale(.4);opacity:0}100%{transform:scale(1);opacity:1}}
.splash-title{
  margin-top:24px;font-size:36px;font-weight:900;letter-spacing:1px;
  background:linear-gradient(135deg,#fff,var(--green));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.splash-sub{margin-top:8px;color:var(--text-3);font-size:13px}
.splash-loader{
  margin-top:32px;width:40px;height:40px;border-radius:50%;
  border:3px solid var(--surface-2);border-top-color:var(--green);
  animation:spin 1s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}

/* ===== Header ===== */
header{
  position:sticky;top:0;z-index:100;
  background:rgba(10,14,20,.95);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid var(--surface-2);
  padding:14px 16px;
  display:flex;align-items:center;justify-content:space-between;
}
.brand{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:900}
.brand-icon{font-size:26px}
.brand-text{
  background:linear-gradient(135deg,#fff,var(--green));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.live-dot{
  display:inline-flex;align-items:center;gap:5px;
  background:rgba(255,59,48,.15);color:var(--red);
  padding:5px 10px;border-radius:20px;font-size:11px;font-weight:bold;
}
.live-dot::before{
  content:"";width:6px;height:6px;border-radius:50%;background:var(--red);
  animation:blink 1.2s infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

/* ===== Main ===== */
main{padding:16px 0 20px}
.section{margin-bottom:24px}
.section-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 16px 10px;
}
.section-title{
  display:flex;align-items:center;gap:8px;
  font-size:16px;font-weight:800;color:var(--text);
}
.section-title::before{
  content:"";width:4px;height:18px;border-radius:2px;background:var(--green);
}
.see-all{
  color:var(--green);font-size:12px;font-weight:600;
  text-decoration:none;padding:4px 8px;
}

/* ===== Matches row ===== */
.matches-scroll{
  display:flex;gap:12px;overflow-x:auto;
  padding:0 16px 8px;scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch;
}
.matches-scroll::-webkit-scrollbar{display:none}
.matches-scroll{scrollbar-width:none}

/* ===== Match Card ===== */
.match-card{
  min-width:280px;flex-shrink:0;scroll-snap-align:start;
  background:var(--surface);border-radius:14px;
  padding:14px;border:1px solid var(--surface-2);
  transition:transform .2s;
}
.match-card:active{transform:scale(.98)}
.match-card.full{min-width:100%;flex-shrink:1}

.mc-head{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:12px;
}
.mc-league{font-size:11px;color:var(--text-3);font-weight:600}
.mc-status{
  font-size:10px;font-weight:bold;padding:3px 8px;border-radius:20px;
}
.mc-status.live{
  background:rgba(255,59,48,.15);color:var(--red);
}
.mc-status.live::before{
  content:"●";margin-left:4px;
  animation:blink 1.2s infinite;
}
.mc-status.upcoming{background:rgba(33,150,243,.15);color:var(--blue)}
.mc-status.finished{background:var(--surface-2);color:var(--text-3)}

.mc-body{display:flex;align-items:center;justify-content:space-between;gap:8px}
.mc-team{
  display:flex;flex-direction:column;align-items:center;gap:6px;
  flex:1;min-width:0;
}
.mc-logo{
  width:38px;height:38px;border-radius:50%;
  background:linear-gradient(135deg,var(--surface-2),var(--surface));
  display:flex;align-items:center;justify-content:center;
  font-weight:bold;color:var(--green);font-size:15px;
  border:1px solid var(--surface-2);
}
.mc-name{
  font-size:11px;color:var(--text-2);font-weight:600;
  text-align:center;white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis;max-width:100%;
}
.mc-score{
  background:var(--black);padding:6px 12px;border-radius:10px;
  font-size:17px;font-weight:900;color:var(--green);
  min-width:64px;text-align:center;
}
.mc-time{
  background:var(--black);padding:6px 12px;border-radius:10px;
  font-size:14px;font-weight:800;color:var(--text);
  min-width:64px;text-align:center;
}
.mc-stadium{
  margin-top:10px;font-size:10px;color:var(--text-3);
  text-align:center;
}

/* ===== Horizontal chips (Leagues) ===== */
.chips{
  display:flex;gap:10px;overflow-x:auto;
  padding:0 16px 8px;-webkit-overflow-scrolling:touch;
}
.chips::-webkit-scrollbar{display:none}
.chips{scrollbar-width:none}
.chip{
  flex-shrink:0;padding:10px 16px;border-radius:30px;
  background:var(--surface);border:1px solid var(--surface-2);
  color:var(--text);font-size:12px;font-weight:600;
  cursor:pointer;transition:all .2s;white-space:nowrap;
}
.chip:active{background:var(--surface-2)}
.chip.on{background:var(--green);color:var(--black);border-color:var(--green)}

/* ===== News ===== */
.news-item{
  margin:0 16px 10px;padding:12px;border-radius:12px;
  background:var(--surface);border:1px solid var(--surface-2);
  display:flex;gap:12px;align-items:center;
}
.news-thumb{
  width:56px;height:56px;border-radius:10px;flex-shrink:0;
  background:var(--surface-2);display:flex;align-items:center;
  justify-content:center;font-size:26px;
}
.news-body{flex:1;min-width:0}
.news-title{
  color:var(--text);font-size:13px;font-weight:700;
  margin-bottom:4px;line-height:1.4;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.news-meta{font-size:10px;color:var(--text-3)}

/* ===== Page (for switching) ===== */
.page{display:none;animation:fade .3s}
.page.on{display:block}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ===== Bottom nav ===== */
nav.bottom{
  position:fixed;bottom:0;left:0;right:0;z-index:200;
  background:rgba(20,26,34,.98);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border-top:1px solid var(--surface-2);
  display:flex;justify-content:space-around;
  padding:8px 0 10px;
  padding-bottom:calc(10px + env(safe-area-inset-bottom));
}
.nav-item{
  flex:1;display:flex;flex-direction:column;align-items:center;
  gap:3px;padding:6px 0;color:var(--text-3);
  font-size:10px;font-weight:600;cursor:pointer;
  background:none;border:none;font-family:inherit;
  transition:color .2s;
}
.nav-item .nav-icon{font-size:20px;line-height:1;filter:grayscale(1) opacity(.7);transition:all .2s}
.nav-item.on{color:var(--green)}
.nav-item.on .nav-icon{filter:none;transform:translateY(-2px)}

/* ===== Detail page ===== */
.detail-header{
  padding:16px;display:flex;align-items:center;gap:12px;
  border-bottom:1px solid var(--surface-2);
}
.back-btn{
  background:var(--surface);border:1px solid var(--surface-2);
  color:var(--text);width:36px;height:36px;border-radius:50%;
  font-size:18px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
}
.detail-title{font-size:16px;font-weight:800;color:var(--text)}

.score-board{
  margin:16px;padding:20px;
  background:linear-gradient(135deg,var(--surface),var(--surface-2));
  border-radius:16px;border:1px solid var(--surface-2);
  text-align:center;
}
.sb-league{font-size:12px;color:var(--text-3);margin-bottom:6px}
.sb-status{display:inline-block;margin-bottom:16px}
.sb-teams{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
}
.sb-team{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;
}
.sb-logo{
  width:56px;height:56px;border-radius:50%;
  background:var(--black);border:2px solid var(--surface-2);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;font-weight:900;color:var(--green);
}
.sb-name{font-size:12px;color:var(--text-2);font-weight:600;text-align:center}
.sb-score{
  font-size:32px;font-weight:900;color:var(--green);
  background:var(--black);padding:10px 18px;border-radius:14px;
  letter-spacing:2px;
}
.sb-vs{
  font-size:16px;color:var(--text-3);font-weight:700;
  background:var(--black);padding:10px 16px;border-radius:14px;
}
.sb-stadium{margin-top:14px;font-size:11px;color:var(--text-3)}

.events-box{margin:16px;background:var(--surface);border-radius:14px;padding:14px;border:1px solid var(--surface-2)}
.events-title{font-size:14px;font-weight:800;color:var(--text);margin-bottom:10px;padding-right:8px;border-right:3px solid var(--green)}
.event-row{
  display:flex;align-items:center;gap:10px;
  padding:8px 0;border-bottom:1px dashed var(--surface-2);
  font-size:12px;
}
.event-row:last-child{border-bottom:none}
.event-min{
  min-width:34px;text-align:center;font-weight:800;color:var(--green);
  background:var(--black);border-radius:8px;padding:3px 6px;font-size:11px;
}
.event-icon{font-size:16px}
.event-text{flex:1;color:var(--text-2)}
.event-text b{color:var(--text);font-weight:700}

.empty{
  padding:40px 20px;text-align:center;color:var(--text-3);font-size:13px;
}

/* ===== Toast ===== */
.toast{
  position:fixed;bottom:96px;left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--green);color:var(--black);padding:10px 20px;
  border-radius:30px;font-weight:700;font-size:13px;
  opacity:0;pointer-events:none;transition:all .3s;
  z-index:500;box-shadow:0 10px 30px rgba(0,230,118,.4);
}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}

@media (min-width:600px){
  .match-card{min-width:320px}
  main{max-width:900px;margin:0 auto}
  nav.bottom{max-width:900px;margin:0 auto;left:50%;transform:translateX(-50%);right:auto;width:100%}
}
</style>
</head>
