      <div class="detail-title">تفاصيل المباراة</div>
    </div>
    <div id="detailContent"></div>
  </section>

</main>

<!-- Bottom nav -->
<nav class="bottom">
  <button class="nav-item on" data-page="home" onclick="goPage('home')">
    <span class="nav-icon">🏠</span><span>الرئيسية</span>
  </button>
  <button class="nav-item" data-page="matches" onclick="goPage('matches')">
